# --- Runtime ---
PORT=8086
NODE_ENV=development

# --- Mongo ---
# Shared cluster with urbancare_monolith; Quill uses its own collections
# (chat_apps, chat_rooms, chat_participants, chat_messages).
MONGO_URI=mongodb://localhost:27017/urbancare

# --- Master encryption key (REQUIRED) ---
# 32 random bytes as hex (64 chars). Used to envelope-encrypt every app's
# private key stored in chat_apps.encryptedKey. Losing this == losing access
# to every app key in the DB. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
QUILL_MASTER_KEY=replace-with-64-hex-chars

# --- Admin bearer token (REQUIRED) ---
# Single root credential for /admin/** endpoints. Treat as a password.
# Generate with the same one-liner as above.
QUILL_ADMIN_TOKEN=replace-with-long-random-hex

# --- CORS ---
# Comma-separated origins allowed to open Socket.IO connections (e.g.
# https://urbancare.ge,https://admin.urbancare.ge). `*` permitted in
# development only.
QUILL_CORS_ORIGINS=*

# --- App registration ---
# There are NO per-app env vars. Apps are created at runtime via the admin
# API, with their private keys generated server-side and stored encrypted in
# chat_apps. See `scripts/admin-smoke.mjs` or:
#
#   curl -X POST http://localhost:8086/admin/apps \
#     -H "Authorization: Bearer $QUILL_ADMIN_TOKEN" \
#     -H "Content-Type: application/json" \
#     -d '{"label":"my-app"}'
#
# Response includes the plaintext privateKey ONCE — capture it immediately.
